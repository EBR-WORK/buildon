# ---------------------------------------------------------------------------
# The shape of .env.local, with no values in it. This file IS committed -- it
# is the checked-in record of which variables the app needs.
#
# Copy it to get started:   cp .env.example .env.local
#
# Netlify needs the same variables under Site settings -> Environment
# variables. A value that is only in .env.local exists on one laptop; the
# build will not see it.
# ---------------------------------------------------------------------------

# --- Supabase, read in the browser ----------------------------------------
# NEXT_PUBLIC_ is inlined into the client bundle, so these are public by
# design. Row level security is what protects the data, not the key.
#
# Supabase renamed these keys. New projects issue a `sb_publishable_...` key;
# older ones issue a JWT `anon` key. src/lib/cms/supabase.ts reads whichever
# is set, so fill in the one your project gives you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase, build only --------------------------------------------------
# The secret key bypasses row level security: never NEXT_PUBLIC_, never
# imported from a client component. New projects call this `sb_secret_...`;
# older ones call it the service role key.
SUPABASE_SECRET_KEY=

# --- Supabase, migrations only ---------------------------------------------
# The direct database connection string, used by `npm run db:migrate`.
# Creating tables is DDL, which the key-based API cannot do at all.
# Project Settings -> Database -> Connection string -> URI.
# Optional: the dashboard SQL editor does the same job with no setup.
SUPABASE_DB_URL=

# --- Storage ---------------------------------------------------------------
# Bucket for uploaded images, replacing the data URLs the admin currently
# keeps in the draft.
NEXT_PUBLIC_SUPABASE_BUCKET=media

# --- Publishing ------------------------------------------------------------
# The site is a static export, so content is only read at build time. Saving
# in the admin changes nothing live until a build runs; this hook starts one.
NETLIFY_BUILD_HOOK_URL=
